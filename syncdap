#!/usr/bin/env bash
# ==============================================================================
# Script: syncdap / download.sh
# Purpose: Modular Spotify audio downloader, quality switcher/upgrader,
#          metadata/genre enricher, cover embedding, lyrics fetcher,
#          playlist manager, and Rockbox/DAP Romaji transliterator.
# ==============================================================================

set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

# Source modular libraries
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/downloader.sh"
source "$SCRIPT_DIR/lib/playlists.sh"

# --- HELP AND USAGE ---
show_help() {
    cat << 'EOF'
Usage:
  syncdap [OPTIONS] <SPOTIFY_URL>
  syncdap [COMMAND] [OPTIONS]

Primary Commands & Modes:
  <URL>                        Download album, playlist, or track from Spotify.
  -p, --patch [FMT] [TARGET]   Patch library tracks or playlist to FORMAT (default: flac).
                               Target can be a playlist name (.m3u8), artist, album, or all.
                               Alias: -u, --upgrade
  -R, --romaji [TARGET]        Transliterate Japanese Kanji/Kana to Romaji (Hepburn) & sanitize
                               FAT32 paths for Rockbox DAPs. Target: playlist, path, or --all.
                               Alias: --transliterate, --rockbox-romaji
  -P, --playlist [NAME]        Interactive playlist manager (create, edit, merge, delete).
                               When passed with an argument to other commands, sets target playlist.
  -D, --delete [PLAYLIST]      Delete a playlist and its audio files from disk.
                               Alias: --delete-playlist
  -M, --merge PL1 PL2 [OUT]    Merge two playlists into one, deduplicating shared tracks.
                               Alias: --merge-playlists
  -e, --embed                  Embed album cover art (cover.jpg) into all audio files.
                               Alias: --embed-all, --embed-covers, --revert-optimize
  -o, --optimize               Optimize for Rockbox/DAP: strip embedded covers, preserve cover.jpg.
                               When used standalone: optimizes library. When used with URL: optimizes download.
                               Alias: --optimize-all
  -g, --genres                 Enrich genre metadata album-by-album (iTunes -> Deezer -> MusicBrainz).
                               Alias: --genres-all
  -l, --lyrics                 Scan and download missing .lrc lyrics for audio tracks.
  -f, --fallback [URL]         Direct yt-dlp rescue with metadata, cover art, and lyrics.
                               If no URL is given: rescues failed tracks from 'erros.spotdl'.
                               Alias: --fallback-only

Universal & Compatible Options (Work across multiple commands):
  -a, --all                    Apply command to entire music library (romaji, patch, embed, optimize, genres, lyrics).
  -d, --dry-run                Simulate actions without modifying files on disk (romaji, patch, delete).
  -y, --yes                    Assume yes to all prompts / automated non-interactive mode (patch, delete, merge).
  -F, --format FORMAT          Audio format: flac, mp3, m4a, opus, ogg, wav (download, patch, fallback).
  -P, --playlist NAME          Target specific playlist for --patch, --romaji, --delete, or --lyrics.
  -r, --root-dir DIR           Root library / player directory (e.g. /run/media/bagi/F695-0800 or .).
  -t, --threads NUM            Concurrency level for downloads and processing (default: 4).
  --keep-old                   In patch mode, keep original files alongside new files.
  --synced-only                In lyrics search, accept only timestamped synced lyrics ([mm:ss]).
  -h, --help                   Display this help message and exit.

Examples:
  syncdap "https://open.spotify.com/album/..."
  syncdap -F flac "https://open.spotify.com/album/..."
  syncdap --patch flac "citypop (WIP)"
  syncdap -p flac -d
  syncdap -R --all
  syncdap -R -P "Osu.m3u8" -r /run/media/bagi/F695-0800 -d
  syncdap -P
  syncdap --delete "citypop (WIP)" -y
  syncdap --merge "pl1" "pl2" "merged_pl"
  syncdap --embed
  syncdap --optimize
  syncdap --genres
  syncdap --lyrics --synced-only
  syncdap --fallback
EOF
}

# --- CLI ARGUMENT PARSER ---
parse_arguments() {
    if [ $# -eq 0 ]; then
        echo -e "${RED}❌ Error: No URL or command provided.${RESET}"
        echo ""
        show_help
        exit 1
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -F|--format)
                if [[ $# -lt 2 ]] || [[ "$2" =~ ^- ]]; then
                    echo -e "${RED}❌ Error: --format requires an argument (flac, mp3, m4a, opus, ogg, wav).${RESET}"
                    exit 1
                fi
                AUDIO_FORMAT="$2"
                PATCH_FORMAT="$2"
                shift 2
                ;;
            -p|--patch|-u|--upgrade)
                PATCH_MODE=true
                if [[ $# -gt 1 ]] && ! [[ "$2" =~ ^- ]]; then
                    PATCH_FORMAT="$2"
                    shift 2
                else
                    PATCH_FORMAT="${PATCH_FORMAT:-flac}"
                    shift 1
                fi
                ;;
            -R|--romaji|--transliterate|--rockbox-romaji)
                ROMAJI_MODE=true
                DO_ROMAJI=true
                shift 1
                if [[ $# -gt 0 ]] && ! [[ "$1" =~ ^- ]]; then
                    ROMAJI_TARGET="$1"
                    shift 1
                fi
                ;;
            -P|--playlist)
                if [[ $# -gt 1 ]] && ! [[ "$2" =~ ^- ]]; then
                    PLAYLIST_NAME="$2"
                    shift 2
                else
                    PLAYLIST_MANAGER_MODE=true
                    shift 1
                fi
                ;;
            -D|--delete|--delete-playlist)
                DELETE_PLAYLIST_MODE=true
                if [[ $# -gt 1 ]] && ! [[ "$2" =~ ^- ]]; then
                    DELETE_PLAYLIST_TARGET="$2"
                    shift 2
                else
                    shift 1
                fi
                ;;
            -M|--merge|--merge-playlists)
                MERGE_PLAYLIST_MODE=true
                if [[ $# -lt 3 ]] || [[ "$2" =~ ^- ]] || [[ "$3" =~ ^- ]]; then
                    echo -e "${RED}❌ Error: --merge requires two source playlist names (e.g. 'syncdap --merge pl1 pl2 [out]').${RESET}"
                    exit 1
                fi
                MERGE_PL1="$2"
                MERGE_PL2="$3"
                shift 3
                if [[ $# -gt 0 ]] && ! [[ "$1" =~ ^- ]]; then
                    MERGE_OUT="$1"
                    shift 1
                fi
                ;;
            -r|--root-dir)
                if [[ $# -lt 2 ]] || [[ "$2" =~ ^- ]]; then
                    echo -e "${RED}❌ Error: --root-dir requires a directory path.${RESET}"
                    exit 1
                fi
                ROMAJI_ROOT="$2"
                shift 2
                ;;
            -a|--all)
                ALL_MODE=true
                OPTIMIZE_ALL=true
                EMBED_ALL=true
                GENRES_ALL=true
                shift 1
                ;;
            -d|--dry-run)
                DRY_RUN=true
                shift 1
                ;;
            -y|--yes)
                ASSUME_YES=true
                shift 1
                ;;
            --filter)
                if [[ $# -gt 1 ]] && ! [[ "$2" =~ ^- ]]; then
                    PATCH_FILTER="$2"
                    shift 2
                else
                    echo -e "${RED}❌ Error: --filter requires a search term or playlist.${RESET}"
                    exit 1
                fi
                ;;
            --keep-old)
                KEEP_OLD=true
                shift 1
                ;;
            -o|--optimize|--optimize-all)
                DO_OPTIMIZE=true
                OPTIMIZE_ALL=true
                shift 1
                ;;
            -e|--embed|--embed-all|--revert-optimize|--embed-covers)
                EMBED_ALL=true
                shift 1
                ;;
            -g|--genres|--genres-all)
                GENRES_ALL=true
                shift 1
                ;;
            -l|--lyrics)
                FETCH_LYRICS=true
                shift 1
                ;;
            --synced-only)
                SYNCED_ONLY=true
                shift 1
                ;;
            -t|--threads)
                if [[ $# -lt 2 ]] || ! [[ "$2" =~ ^[0-9]+$ ]] || [ "$2" -le 0 ]; then
                    echo -e "${RED}❌ Error: --threads requires a positive integer.${RESET}"
                    exit 1
                fi
                THREADS="$2"
                shift 2
                ;;
            -f|--fallback|--fallback-only)
                FALLBACK_ONLY=true
                shift 1
                if [[ $# -gt 0 ]] && [[ "$1" =~ ^https://open\.spotify\.com/ ]]; then
                    RAW_URL="$1"
                    shift 1
                fi
                ;;
            https://open.spotify.com/*)
                RAW_URL="$1"
                shift 1
                ;;
            *)
                if [ "$PATCH_MODE" = true ] && [ -z "$PATCH_FILTER" ]; then
                    PATCH_FILTER="$1"
                    shift 1
                elif [ "$DELETE_PLAYLIST_MODE" = true ] && [ -z "$DELETE_PLAYLIST_TARGET" ]; then
                    DELETE_PLAYLIST_TARGET="$1"
                    shift 1
                elif [ "$ROMAJI_MODE" = true ] && [ -z "$ROMAJI_TARGET" ]; then
                    ROMAJI_TARGET="$1"
                    shift 1
                else
                    echo -e "${RED}❌ Error: Unrecognized argument: $1${RESET}"
                    echo "Run '$0 --help' for usage instructions."
                    exit 1
                fi
                ;;
        esac
    done

    # Resolve cross-compatible playlist target
    if [ -n "$PLAYLIST_NAME" ]; then
        if [ "$PATCH_MODE" = true ] && [ -z "$PATCH_FILTER" ]; then
            PATCH_FILTER="$PLAYLIST_NAME"
        elif [ "$DELETE_PLAYLIST_MODE" = true ] && [ -z "$DELETE_PLAYLIST_TARGET" ]; then
            DELETE_PLAYLIST_TARGET="$PLAYLIST_NAME"
        elif [ "$ROMAJI_MODE" = true ] && [ -z "$ROMAJI_TARGET" ]; then
            ROMAJI_TARGET="$PLAYLIST_NAME"
        elif [ "$PATCH_MODE" = false ] && [ "$DELETE_PLAYLIST_MODE" = false ] && [ "$ROMAJI_MODE" = false ] && [ -z "$RAW_URL" ]; then
            # Standalone playlist name passed with -P: launch interactive manager or view
            PLAYLIST_MANAGER_MODE=true
        fi
    fi

    # Clean Spotify URL if provided
    if [ -n "$RAW_URL" ]; then
        CLEAN_URL=$(echo "$RAW_URL" | grep -oE 'https://open\.spotify\.com/(playlist|album|track)/[a-zA-Z0-9]+' | head -n 1)
        if [ -z "$CLEAN_URL" ]; then
            echo -e "${RED}❌ Error: Invalid Spotify URL.${RESET}"
            exit 1
        fi
    fi

    # Format validation
    if [ "$PATCH_MODE" = true ]; then
        validate_format "$PATCH_FORMAT"
    else
        validate_format "$AUDIO_FORMAT"
    fi

    # Action validation
    if [ "$PLAYLIST_MANAGER_MODE" = false ] && [ "$MERGE_PLAYLIST_MODE" = false ] && \
       [ "$DELETE_PLAYLIST_MODE" = false ] && [ "$PATCH_MODE" = false ] && [ "$ROMAJI_MODE" = false ] && \
       [ "$OPTIMIZE_ALL" = false ] && [ "$EMBED_ALL" = false ] && \
       [ "$GENRES_ALL" = false ] && [ "$FETCH_LYRICS" = false ] && [ "$FALLBACK_ONLY" = false ] && [ -z "$CLEAN_URL" ]; then
        echo -e "${RED}❌ Error: No valid action or URL specified.${RESET}"
        echo ""
        show_help
        exit 1
    fi

    if [ "$FALLBACK_ONLY" = true ] && [ -z "$CLEAN_URL" ] && [ ! -s "erros.spotdl" ]; then
        echo -e "${RED}❌ Error: --fallback requested without URL, but no 'erros.spotdl' file was found.${RESET}"
        exit 1
    fi
}

# --- FALLBACK RESCUE ORCHESTRATION ---
run_fallback_rescue() {
    local batch_meta="$TEMP_DIR/batch_meta.spotdl"
    local has_targets=false

    if [ "$FALLBACK_ONLY" = true ] && [ -n "$CLEAN_URL" ]; then
        echo ""
        echo -e "${CYAN}⚡ Fallback mode: Fetching Spotify metadata...${RESET}"
        spotdl save "$CLEAN_URL" --save-file "$batch_meta" >/dev/null 2>&1 || true
        [ -s "$batch_meta" ] && has_targets=true
    elif [ -s "erros.spotdl" ]; then
        echo ""
        echo -e "${YELLOW}⚠️ [3/5] Starting smart parallel fallback for failed tracks...${RESET}"
        mapfile -t failed_urls < <(grep -oE 'https://open\.spotify\.com/track/[a-zA-Z0-9]+' erros.spotdl | sort -u)
        if [ ${#failed_urls[@]} -gt 0 ]; then
            echo "   Found ${#failed_urls[@]} track(s) for recovery."
            echo "   Fetching official metadata from Spotify..."
            spotdl save "${failed_urls[@]}" --save-file "$batch_meta" >/dev/null 2>&1 || true
            [ -s "$batch_meta" ] && has_targets=true
        fi
    fi

    if [ "$has_targets" = true ]; then
        run_py "$SCRIPT_DIR/lib/fallback.py" \
            "$batch_meta" \
            "$TEMP_DIR" \
            "$TARGET_M3U" \
            "$THREADS" \
            "$SYNCED_ONLY" \
            "$AUDIO_EXT" \
            "${YTDLP_JS_ARGS[*]:-}"
        rm -f erros.spotdl
    else
        if [ "$FALLBACK_ONLY" = false ]; then
            echo ""
            echo -e "${GREEN}✅ [3/5] No failed tracks registered by spotDL.${RESET}"
        fi
    fi
}

# --- COVER ART ORCHESTRATION ---
orchestrate_covers() {
    local mode="${1:-embed}"    # 'embed' or 'optimize'
    local scope="${2:-session}" # 'all' or 'session'
    local dirs_file="$TEMP_DIR/cover_dirs.txt"

    echo ""
    if [ "$scope" = "all" ]; then
        find . -mindepth 2 -maxdepth 2 -type d ! -path "./Playlists*" | sort > "$dirs_file"
    else
        find . -mindepth 2 -maxdepth 2 -type d ! -path "./Playlists*" -newer "$MARKER" | sort > "$dirs_file"
    fi

    run_py "$SCRIPT_DIR/lib/covers.py" "$mode" "$dirs_file" "$THREADS"
}

# --- GENRE ENRICHMENT ORCHESTRATION ---
orchestrate_genres() {
    local scope="${1:-session}" # 'all' or 'session'
    local dirs_file="$TEMP_DIR/genre_dirs.txt"

    echo ""
    if [ "$scope" = "all" ]; then
        echo -e "${MAGENTA}🏷️ Enriching genre metadata across the entire library (album-by-album)...${RESET}"
        find . -mindepth 2 -maxdepth 2 -type d ! -path "./Playlists*" | sort > "$dirs_file"
    else
        echo -e "${MAGENTA}🏷️ [5/5] Checking and enriching genre metadata for downloaded albums...${RESET}"
        find . -mindepth 2 -maxdepth 2 -type d ! -path "./Playlists*" -newer "$MARKER" | sort > "$dirs_file"
    fi

    run_py "$SCRIPT_DIR/lib/genres.py" "$dirs_file" "$THREADS"
}

# --- LYRICS SCANNER ORCHESTRATION ---
orchestrate_lyrics() {
    local scope="${1:-session}" # 'all' or 'session'
    local dirs_file="$TEMP_DIR/lyrics_dirs.txt"

    echo ""
    echo -e "${CYAN}🎵 Scanning for tracks with missing .lrc lyrics...${RESET}"
    if [ "$scope" = "all" ]; then
        find . -mindepth 2 -maxdepth 2 -type d ! -path "./Playlists*" | sort > "$dirs_file"
    else
        find . -mindepth 2 -maxdepth 2 -type d ! -path "./Playlists*" -newer "$MARKER" | sort > "$dirs_file"
    fi

    run_py "$SCRIPT_DIR/lib/lyrics.py" "$dirs_file" "$THREADS" "$SYNCED_ONLY"
}

# --- MAIN ORCHESTRATION ---
main() {
    parse_arguments "$@"
    check_dependencies
    setup_environment

    # Mode 0a: Interactive Playlist Manager Menu
    if [ "$PLAYLIST_MANAGER_MODE" = true ]; then
        run_py "$SCRIPT_DIR/lib/playlist_ops.py" --menu
        exit $?
    fi

    # Mode 0b: Merge Playlists Mode
    if [ "$MERGE_PLAYLIST_MODE" = true ]; then
        local yes_flag=""
        [ "$ASSUME_YES" = true ] && yes_flag="--yes"
        run_py "$SCRIPT_DIR/lib/playlist_ops.py" --merge "$MERGE_PL1" "$MERGE_PL2" ${MERGE_OUT:+"$MERGE_OUT"} $yes_flag
        exit $?
    fi

    # Mode 0c: Delete Playlist Mode
    if [ "$DELETE_PLAYLIST_MODE" = true ]; then
        local yes_flag=""
        [ "$ASSUME_YES" = true ] && yes_flag="--yes"
        local del_target="${DELETE_PLAYLIST_TARGET:-$PLAYLIST_NAME}"
        if [ -z "$del_target" ]; then
            echo -e "${RED}❌ Error: --delete requires a playlist name or file.${RESET}"
            exit 1
        fi
        run_py "$SCRIPT_DIR/lib/playlist_ops.py" --delete "$del_target" $yes_flag
        exit $?
    fi

    # Mode 1: Romaji Transliteration Mode
    if [ "$ROMAJI_MODE" = true ] && [ -z "$CLEAN_URL" ]; then
        echo ""
        echo -e "${BOLD}${CYAN}🎌 Starting Rockbox Romaji Transliteration...${RESET}"
        local romaji_args=("-r" "$ROMAJI_ROOT" "-t" "$THREADS")
        [ "$DRY_RUN" = true ] && romaji_args+=("-d")
        local target="${ROMAJI_TARGET:-$PLAYLIST_NAME}"
        if [ -n "$target" ]; then
            romaji_args+=("-p" "$target")
        elif [ "$ALL_MODE" = true ] || [ -z "$target" ]; then
            romaji_args+=("-a")
        fi
        run_py "$SCRIPT_DIR/lib/romaji.py" "${romaji_args[@]}"
        exit $?
    fi

    # Mode 2: Quality Patch Mode (e.g. MP3 -> FLAC)
    if [ "$PATCH_MODE" = true ]; then
        local patch_target="${PATCH_FILTER:-$PLAYLIST_NAME}"
        echo ""
        echo -e "${BOLD}${BLUE}🚀 Starting Quality Patch to ${PATCH_FORMAT^^}...${RESET}"
        run_py "$SCRIPT_DIR/lib/patch.py" \
            "$PATCH_FORMAT" \
            "$TEMP_DIR" \
            "$THREADS" \
            "$KEEP_OLD" \
            "$DRY_RUN" \
            "$patch_target" \
            "${YTDLP_JS_ARGS[*]:-}" \
            "$ASSUME_YES"
        cleanup_empty_dirs
        echo ""
        echo -e "${GREEN}🎉 Quality patch process completed successfully!${RESET}"
        exit 0
    fi

    # Mode 3: Rockbox/DAP library-wide optimization
    if [ "$OPTIMIZE_ALL" = true ] && [ -z "$CLEAN_URL" ] && [ "$FALLBACK_ONLY" = false ]; then
        orchestrate_covers "optimize" "all"
        cleanup_empty_dirs
        echo ""
        echo -e "${GREEN}🎉 Library optimization completed successfully!${RESET}"
        exit 0
    fi

    # Mode 4: Embed all covers
    if [ "$EMBED_ALL" = true ] && [ -z "$CLEAN_URL" ] && [ "$FALLBACK_ONLY" = false ]; then
        orchestrate_covers "embed" "all"
        if [ "$GENRES_ALL" = true ]; then
            orchestrate_genres "all"
        fi
        cleanup_empty_dirs
        echo ""
        echo -e "${GREEN}🎉 Cover art embedding completed successfully!${RESET}"
        exit 0
    fi

    # Mode 5: Standalone genre enrichment
    if [ "$GENRES_ALL" = true ] && [ -z "$CLEAN_URL" ] && [ "$FALLBACK_ONLY" = false ]; then
        orchestrate_genres "all"
        cleanup_empty_dirs
        echo ""
        echo -e "${GREEN}🎉 Genre enrichment completed successfully!${RESET}"
        exit 0
    fi

    # Mode 6: Standalone missing lyrics search
    if [ "$FETCH_LYRICS" = true ] && [ -z "$CLEAN_URL" ] && [ "$FALLBACK_ONLY" = false ]; then
        orchestrate_lyrics "all"
        cleanup_empty_dirs
        echo ""
        echo -e "${GREEN}🎉 Lyrics processing completed successfully!${RESET}"
        exit 0
    fi

    # Mode 7: Fallback rescue
    if [ "$FALLBACK_ONLY" = true ]; then
        run_fallback_rescue
        if [ "$DO_OPTIMIZE" = true ]; then
            orchestrate_covers "optimize" "session"
        else
            orchestrate_covers "embed" "session"
        fi
        orchestrate_genres "session"
        if [ "$FETCH_LYRICS" = true ]; then
            orchestrate_lyrics "session"
        fi
        cleanup_empty_dirs
        echo ""
        echo -e "${GREEN}🎉 Fallback rescue completed successfully!${RESET}"
        exit 0
    fi

    # Mode 8: Standard Spotify download flow
    run_spotdl_download
    process_playlists
    run_fallback_rescue

    if [ "$DO_OPTIMIZE" = true ]; then
        orchestrate_covers "optimize" "session"
    else
        orchestrate_covers "embed" "session"
    fi

    orchestrate_genres "session"

    if [ "$FETCH_LYRICS" = true ]; then
        orchestrate_lyrics "session"
    fi

    if [ "$DO_ROMAJI" = true ]; then
        echo ""
        echo -e "${CYAN}🎌 Transliterating downloaded tracks to Romaji...${RESET}"
        run_py "$SCRIPT_DIR/lib/romaji.py" -r "." -t "$THREADS" -a
    fi

    cleanup_empty_dirs

    echo ""
    echo -e "${GREEN}🎉 Download & processing finished successfully!${RESET}"
    exit 0
}

main "$@"
